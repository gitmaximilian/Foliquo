{
  "name": "foliquo",
  "version": "0.11.11",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Maximilian Auer",
    "email": "175149220+gitmaximilian@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/foliquo.mjs",
    "test": "node --test --test-force-exit --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:storage": "node scripts/storage-scale.mjs",
    "test:backup:scale": "node scripts/backup-scale.mjs",
    "test:storage:memory": "node --expose-gc scripts/storage-memory.mjs",
    "test:storage:large-pdf": "node --expose-gc scripts/profile-large-pdf.mjs",
    "test:recovery:profile": "node --expose-gc scripts/recovery-profile.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "learning:impact": "node scripts/learning-impact.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "doctor": "node scripts/check-install.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "package": "node scripts/package-release.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "node scripts/prepare-desktop.mjs && cd desktop && tauri build"
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "bmp-js": "^0.1.0",
    "fflate": "^0.8.3",
    "heic-convert": "^2.1.0",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0"
  },
  "bin": {
    "foliquo": "bin/foliquo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4"
  }
}
